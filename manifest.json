
{
  "manifest_version": 3,
  "name": "Google Forms Autofill",
  "version": "1.0.0",
  "description": "Open Google Forms in Brave and autofill recognized fields for manual review.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://docs.google.com/forms/*"
  ],
  "action": {
    "default_title": "Google Forms Autofill",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
